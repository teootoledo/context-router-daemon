{
  "name": "@teootoledo/context-router-daemon",
  "version": "0.1.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "description": "Local MCP daemon exposing bulk_read_files; owns all filesystem access for the context-router system.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "context-router-daemon": "./src/index.ts"
  },
  "files": [
    "src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/teootoledo/context-router-daemon.git"
  },
  "bugs": {
    "url": "https://github.com/teootoledo/context-router-daemon/issues"
  },
  "homepage": "https://github.com/teootoledo/context-router-daemon#readme",
  "scripts": {
    "start": "tsx src/index.ts",
    "bench": "tsx bench/bulk-read-bench.ts",
    "test": "tsx --test test/*.test.ts",
    "build:hooks": "esbuild adapters/claude-code/hooks/src/checkFileSize.ts adapters/claude-code/hooks/src/checkBashRead.ts --bundle --platform=node --format=esm --outdir=adapters/claude-code/hooks --banner:js=\"#!/usr/bin/env node\" && chmod +x adapters/claude-code/hooks/checkFileSize.js adapters/claude-code/hooks/checkBashRead.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@teootoledo/context-router-contract": "^0.1.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "esbuild": "^0.28.2",
    "semantic-release": "^25.0.9",
    "tsx": "^4.19.0"
  }
}
